# --- Etapa 1: compilar el frontend (React/Vite) ---
FROM node:22-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Etapa 2: API (FastAPI) que además sirve frontend/dist ---
FROM python:3.14-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY deploy/bot/requirements.txt /tmp/toolia-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/toolia-requirements.txt \
    && rm /tmp/toolia-requirements.txt \
    && useradd --create-home --user-group --uid 10001 toolia \
    && install -d -o toolia -g toolia /var/lib/toolia /var/lib/toolia-chats

COPY src/ src/
COPY rag_test/ rag_test/
COPY --from=frontend /frontend/dist frontend/dist

USER toolia
EXPOSE 8000
CMD ["python", "src/api/app.py", "--host", "0.0.0.0", "--port", "8000"]
